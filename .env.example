# The local FastAPI origin (do not append /api).
PENROSE_API_URL=http://127.0.0.1:8000

# Match one dispatcher-role token in backend DISPATCH_API_TOKENS.
# Keep the actual value only in .env.local or a server-side secret store.
# PENROSE_DISPATCH_TOKEN=<random-token-at-least-32-characters>

# Local development only: permits Agent commands when the request hostname
# is localhost or 127.0.0.1. Leave unset in public deployments.
# PENROSE_AGENT_LOCAL_ONLY=true

# Only set this in a deployment where a trusted gateway strips untrusted
# oai-authenticated-user-* headers and injects verified ChatGPT identity.
# Public dispatcher commands remain disabled otherwise.
# PENROSE_AGENT_TRUSTED_AUTH_PROXY=true
