# Dependencies and package-manager caches
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests and generated application output
/coverage
/.next/
/.vinext/
/out/
/dist/
/.turbo/

# Local Cloudflare and checkout runtime state
/.wrangler/
/.sites-runtime/
/.agents/
/.codex/
