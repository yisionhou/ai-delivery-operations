/work/

# Local secrets; allow example files to be committed
.env*
!.env.example
!.env.*.example
.dev.vars*
!.dev.vars.example

# TypeScript and local tooling caches
*.tsbuildinfo
.cache/

# Logs and OS/editor files
.DS_Store
Thumbs.db
*.log
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-env.d.ts
.vercel/
